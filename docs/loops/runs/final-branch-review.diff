++    <div data-testid="kennzahl-hero">
++      <p className="eyebrow">Bildungskapital heute</p>
++      <p className="hero-number" style={{ fontSize: 'clamp(1.8rem, 4vw, 3.4rem)', margin: 0 }}>
++        {formatEuro(angezeigt)}
++      </p>
++    </div>
++  );
++}
