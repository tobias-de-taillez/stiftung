+
+describe('SpendenTicker', () => {
+  it('zeigt den Empty-State, wenn keine Spenden vorhanden sind', async () => {
+    vi.stubGlobal('fetch', vi.fn().mockResolvedValue({ ok: true, json: async () => [] }));
