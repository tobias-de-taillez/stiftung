+ * Inline-Style-Wert). Degradiert unter prefers-reduced-motion automatisch
+ * über den globalen Override unten.
+ */
+.mini-balkenwald-bar {
+  animation: mini-balkenwald-grow 700ms ease-out;
+}
+
+@keyframes mini-balkenwald-grow {
+  from {
+    height: 0;
+  }
+}
