++          PHASE_KAPITAL_MS + naechsterStand * ITEM_STAGGER_MS
++        )
++      );
++    }
++    timers.push(
++      setTimeout(
++        () => setPhase('abschluss'),
++        PHASE_KAPITAL_MS + verteilung.length * ITEM_STAGGER_MS + PHASE_ABSCHLUSS_PUFFER_MS
++      )
++    );
