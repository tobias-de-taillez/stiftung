+/*
+ * Hero-Grid (Task 35): zweispaltig ab 800px — links Text/CTAs, rechts der
+ * Visual-Slot (KennzahlHero + MiniBalkenwald + Live-Ticker), damit bei der
+ * 1080px-Container-Breite keine leere dunkle Fläche rechts mehr entsteht.
+ * Unter 800px fällt die Regel unten auf einspaltig zurück — derselbe
+ * Breakpoint wie die bestehende .container-Padding-Regel.
+ */
+.hero-grid {
+  display: grid;
+  grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
+  gap: 2.5rem;
+  align-items: start;
+}
+
+/*
+ * grid-template-columns: minmax(0, 1fr) statt implizitem Auto-Track — sonst
+ * sizt sich die einzelne Spalte an ihrem Inhalt (Mini-Balkenwald mit
+ * nowrap-Labels) auf und sprengt die von .hero-grid zugewiesene Breite
+ * (derselbe Grund, warum .hero-grid selbst minmax(0, …) statt reinem fr
+ * nutzt).
+ */
+.hero-visual {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  gap: 1.25rem;
+}
+
+@media (max-width: 800px) {
+  .hero-grid {
+    grid-template-columns: 1fr;
+  }
+}
+
+/*
+ * ProgressBar-Füllung: animiert beim ersten Rendern von 0 auf die Zielbreite.
+ * Nur das "from" wird definiert — das implizite "to"-Keyframe übernimmt den
+ * per Inline-Style gesetzten width-Wert (Standardverhalten der CSS Animations
+ * Spec). Läuft rein über CSS, keine JS-Mount-Erkennung nötig; degradiert unter
+ * `prefers-reduced-motion` automatisch über den globalen Override unten
+ * (animation-duration wird dort auf 0.001ms gekappt).
+ */
+.progress-bar-fill {
+  height: 100%;
+  border-radius: 999px;
+  background: var(--sun);
+  animation: progress-bar-fill-in 800ms ease-out;
+}
+
+.progress-bar-fill.is-complete {
+  background: var(--turquoise);
+}
+
+@keyframes progress-bar-fill-in {
+  from {
+    width: 0;
+  }
+}
+
+/*
+ * Marker für Zwischenziele auf dem Fortschrittsbalken (z. B. die fünf
+ * Einrichtungs-Level Bronze–Diamant, Task 30). Rein dekorativ/informativ
+ * (aria-hidden auf dem Element selbst) — der Tooltip (title) ergänzt die
+ * Bedeutung visuell, das umgebende label-Prop des Balkens trägt sie für
+ * Screenreader.
+ */
+.progress-bar-marker {
+  position: absolute;
+  top: 0;
+  bottom: 0;
+  width: 2px;
+  background: var(--cream);
+  opacity: 0.55;
+  transform: translateX(-50%);
+  pointer-events: auto;
+}
+
+/*
+ * Vorher→Nachher-Balken der Spenden-Bestätigung: Geisterbalken (alter Stand,
+ * blass) liegt unter dem animierten Fill (neuer Stand). Der Fill nutzt
+ * dieselbe progress-bar-fill-in-Animation wie ProgressBar und erbt damit auch
+ * denselben globalen prefers-reduced-motion-Override weiter unten.
+ */
+.vorher-nachher-track {
+  position: relative;
+  background: var(--surface-2);
+  border-radius: 999px;
+  height: 14px;
+  overflow: hidden;
+}
+
+.vorher-nachher-ghost {
+  position: absolute;
+  inset: 0 auto 0 0;
+  height: 100%;
+  border-radius: 999px;
+  background: var(--cream);
+  opacity: 0.28;
+}
+
+.vorher-nachher-fill {
+  position: absolute;
+  inset: 0 auto 0 0;
+  height: 100%;
+  border-radius: 999px;
+  background: var(--sun);
+  animation: progress-bar-fill-in 900ms ease-out;
+}
+
+.vorher-nachher-fill.is-complete {
+  background: var(--turquoise);
+}
+
+/*
+ * Konfetti-Burst: reines CSS, einmalig beim Mounten der Bestätigung. Jede
+ * Drift-Variante ist ein fixes Keyframe (kein JS-Custom-Property-Bedarf),
+ * Zufälligkeit kommt aus Startposition, Verzögerung und Dauer pro Partikel.
+ */
+.konfetti-burst {
+  position: relative;
+  height: 0;
+}
+
+.konfetti-partikel {
+  position: absolute;
+  top: 0;
+  width: 8px;
+  height: 8px;
+  border-radius: 2px;
+  animation-timing-function: ease-out;
+  animation-fill-mode: forwards;
+}
+
+.konfetti-partikel-a { animation-name: konfetti-fall-a; }
+.konfetti-partikel-b { animation-name: konfetti-fall-b; }
+.konfetti-partikel-c { animation-name: konfetti-fall-c; }
+
+@keyframes konfetti-fall-a {
+  from { transform: translate(0, -8px) rotate(0deg); opacity: 1; }
+  to { transform: translate(-36px, 92px) rotate(-220deg); opacity: 0; }
+}
+@keyframes konfetti-fall-b {
+  from { transform: translate(0, -8px) rotate(0deg); opacity: 1; }
+  to { transform: translate(0, 104px) rotate(180deg); opacity: 0; }
+}
+@keyframes konfetti-fall-c {
+  from { transform: translate(0, -8px) rotate(0deg); opacity: 1; }
+  to { transform: translate(36px, 88px) rotate(220deg); opacity: 0; }
+}
+
+/* Reduced-motion: Container komplett ausblenden statt eingefroren stehen lassen. */
+@media (prefers-reduced-motion: reduce) {
