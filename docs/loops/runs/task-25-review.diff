+/*
+ * ProgressBar-Füllung: animiert beim ersten Rendern von 0 auf die Zielbreite.
+ * Nur das "from" wird definiert — das implizite "to"-Keyframe übernimmt den
+ * per Inline-Style gesetzten width-Wert (Standardverhalten der CSS Animations
+ * Spec). Läuft rein über CSS, keine JS-Mount-Erkennung nötig; degradiert unter
+ * `prefers-reduced-motion` automatisch über den globalen Override unten
+ * (animation-duration wird dort auf 0.001ms gekappt).
+ */
+.progress-bar-fill {
+  height: 100%;
+  border-radius: 999px;
+  background: var(--sun);
+  animation: progress-bar-fill-in 800ms ease-out;
+}
+
+.progress-bar-fill.is-complete {
+  background: var(--turquoise);
+}
+
+@keyframes progress-bar-fill-in {
+  from {
+    width: 0;
